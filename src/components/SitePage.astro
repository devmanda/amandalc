---
import SiteChrome from './SiteChrome.astro';
import SiteColophon from './SiteColophon.astro';
import SiteDirectoryNav from './SiteDirectoryNav.astro';

interface Props {
	title: string;
	lede?: string;
}

const { title, lede } = Astro.props;
---

<div id="container">
	<main
		class="relative w-full max-w-none px-5 pb-28 pt-12 text-left sm:px-8 lg:px-12 xl:px-20 2xl:px-28 md:pt-16"
	>
		<SiteChrome variant="inner" />

		<header class="mb-8 md:mb-12">
			<h1
				class="font-headline text-[clamp(2.5rem,8.5vw,6.5rem)] font-normal leading-[0.98] tracking-[-0.02em] text-ink"
			>
				{title}
			</h1>
			{
				lede ? (
					<p class="mt-5 max-w-3xl font-body text-base font-normal leading-relaxed text-ink-muted sm:text-lg md:mt-6 md:text-xl">
						{lede}
					</p>
				) : null
			}
		</header>

		<div class="w-full">
			<slot />
		</div>

		<SiteDirectoryNav />

		<SiteColophon />
	</main>
</div>
