---
/**
 * Top-of-page chrome inspired by editorial portfolio patterns (e.g. henry.codes).
 */
interface Props {
	variant?: 'home' | 'inner';
}

const { variant = 'home' } = Astro.props;
---

<header
	class="mb-8 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2 border-b border-ink/10 pb-6 font-body text-[0.7rem] text-ink-muted md:mb-10"
>
	<p class="m-0">
		<span aria-hidden="true" class="text-ink-faint">✷</span>
		<span class="ml-1.5 tracking-[0.14em] uppercase">ver. 01</span>
	</p>
	{
		variant === 'inner' ? (
			<a
				href="/"
				class="tracking-wide text-ink-muted transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/25 focus-visible:ring-offset-2 focus-visible:ring-offset-stone-50"
			>
				← Back to home
			</a>
		) : (
			<p class="m-0 max-w-[14rem] text-right text-[0.65rem] leading-snug text-ink-faint sm:max-w-none">
				Personal site &amp; portfolio
			</p>
		)
	}
</header>
