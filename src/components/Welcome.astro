---
import SiteChrome from './SiteChrome.astro';
import SiteColophon from './SiteColophon.astro';
import SiteDirectoryNav from './SiteDirectoryNav.astro';
---

<div id="container">
	<main
		class="relative w-full max-w-none px-5 pb-28 pt-12 sm:px-8 lg:px-12 xl:px-20 2xl:px-28 md:pt-16"
	>
		<SiteChrome variant="home" />

		<section id="hero" aria-labelledby="hero-heading" class="text-left">
			<h1
				id="hero-heading"
				class="font-headline text-[clamp(3rem,11vw,9.5rem)] font-normal leading-[0.96] tracking-[-0.02em] text-ink"
			>
				I'm Amanda Christianson.
			</h1>
			<p
				class="mt-6 max-w-3xl font-body text-base font-normal leading-relaxed text-ink-muted sm:text-lg md:mt-8 md:text-xl"
			>
				Technical product leader by day, systems thinker by nature, web developer at heart.
			</p>
		</section>

		<section id="navigation">
			<SiteDirectoryNav />
		</section>

		<SiteColophon />
	</main>
</div>
